{
  "name": "@cf-demos/ignite-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "run-s migrate:local seed:local start:dev",
    "start:dev": "cf dev",
    "migrate:local": "node ../../scripts/d1-migrate.ts --cwd . --outputs infra/local-outputs.json --local --dir migrations/data",
    "seed:local": "node ../../scripts/d1-migrate.ts --cwd . --outputs infra/local-outputs.json --local --dir migrations/seed",
    "migrate:remote": "node ../../scripts/d1-migrate.ts --cwd . --outputs infra/outputs.json --dir migrations/data",
    "build": "vite build --mode development",
    "check": "run-s check:types check:format check:lint check:infra check:infra:fmt check:build check:bundles",
    "check:types": "run-s generate:types check:types:tsc",
    "generate:types": "run-s generate:types:application generate:types:data",
    "generate:types:application": "cf workers types --mode development",
    "generate:types:data": "cd data && cf workers types --mode development",
    "check:types:tsc": "run-s check:types:tsc:main check:types:tsc:integration",
    "check:types:tsc:main": "tsc --noEmit -p tsconfig.json",
    "check:types:tsc:integration": "tsc --noEmit -p tests/integration/tsconfig.json",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --type-aware --type-check .",
    "check:infra": "terraform -chdir=infra validate",
    "check:infra:fmt": "terraform -chdir=infra fmt -check",
    "check:build": "vite build --mode development",
    "check:bundles": "node scripts/bundle-report.ts",
    "report:bundles": "node scripts/bundle-report.ts --write-report",
    "fix": "run-s generate:types fix:format fix:lint fix:infra",
    "fix:format": "oxfmt --write .",
    "fix:lint": "oxlint --type-aware --type-check --fix .",
    "fix:infra": "terraform -chdir=infra fmt",
    "format": "pnpm fix:format",
    "test": "run-s test:vitest test:e2e",
    "test:vitest": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:coverage": "pnpm test:vitest",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project unit",
    "test:client": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project client",
    "test:contract": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project contract",
    "test:integration": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project integration",
    "test:e2e": "playwright test",
    "deploy": "run-s deploy:infra deploy:worker",
    "deploy:infra": "run-s deploy:infra:init deploy:infra:apply",
    "deploy:infra:init": "terraform -chdir=infra init",
    "deploy:infra:apply": "terraform -chdir=infra apply -auto-approve",
    "postdeploy:infra:apply": "terraform -chdir=infra output -json > infra/outputs.json",
    "deploy:worker": "run-s migrate:remote deploy:worker:build deploy:worker:upload:data deploy:worker:upload:application",
    "deploy:worker:build": "vite build --mode production",
    "deploy:worker:upload:data": "cf deploy --prebuilt --worker ignite-crm-data",
    "deploy:worker:upload:application": "cf deploy --prebuilt",
    "teardown": "run-s teardown:worker:application teardown:worker:data teardown:infra",
    "teardown:worker:application": "node scripts/delete-worker.ts ignite-crm-application",
    "teardown:worker:data": "node scripts/delete-worker.ts ignite-crm-data",
    "teardown:infra": "terraform -chdir=infra destroy -auto-approve"
  },
  "dependencies": {
    "@adrianhall/cloudflare-toolkit": "^2.7.0",
    "@ai-sdk/vue": "4.0.140",
    "@cloudflare/ai-chat": "0.12.1",
    "@demos/worker-common": "workspace:*",
    "@mdi/js": "7.4.47",
    "@modelcontextprotocol/server": "2.3.1",
    "@valibot/to-json-schema": "1.0.0",
    "agents": "0.28.1",
    "ai": "7.0.140",
    "dompurify": "3.4.16",
    "hono": "4.13.13",
    "libphonenumber-js": "1.13.15",
    "marked": "18.1.0",
    "valibot": "1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vuetify": "4.2.4",
    "workers-ai-provider": "4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.27",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "cf": "1.0.0-beta.16",
    "commander": "15.0.0",
    "jsdom": "30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
