{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/vitest-plugin/types", "node", "vite/client"]
  },
  "include": [
    "src",
    "scripts",
    "tests/client",
    "tests/worker",
    "infra/outputs.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "cloudflare.config.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "exclude": [
    // Starter-project templates for the scaffold export, imported only as raw text through
    // Vite's `?raw` suffix and never compiled or run by this project. They target a standalone
    // project with its own dependencies — Drizzle, Hono, Astro — that this demo deliberately
    // does not install, so type-checking them here would fail on imports that are correct in
    // the project they are generated into.
    "src/client/lib/scaffold-templates"
  ]
}
