{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/vitest-plugin/types", "node", "vite/client"]
  },
  "include": [
    "src",
    "scripts",
    "tests/worker",
    "infra/outputs.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "cloudflare.config.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
