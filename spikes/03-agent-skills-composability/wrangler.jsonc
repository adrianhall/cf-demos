{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spike-03-agent-skills-composability",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // Deployed for real and driven over its own bypass-fronted public hostname (README.md) — the
  // same reason Spike A had to deploy: a live `env.AI` tool-calling turn cannot be exercised
  // through `wrangler dev`'s remote-binding proxy on this account (docs/DECISIONS.md #11).
  // `workers_dev` is left at its schema default (`true`, since no `routes` are declared), which is
  // what actually published this Worker to its own `*.workers.dev` hostname.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  // Workers AI has no local simulator (docs/05-AI-CHAT.md, "Workers AI Has No Local Simulation";
  // docs/DECISIONS.md #9): this binding always reaches the real account. `remote` must be `true`
  // explicitly — Cloudflare errors on `false` and warns (while still connecting remotely) if
  // omitted.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // The skill catalog's backing store (Spike D's aim: `agents/skills`'s `r2()` source function
  // takes a plain `R2Bucket`). Created imperatively via `wrangler r2 bucket create` (README.md) —
  // not Terraform-owned, since Section 8 only requires Terraform for this account's mandatory
  // Access application, not for every resource a throwaway spike touches.
  "r2_buckets": [{ "binding": "SKILLS", "bucket_name": "spike-03-agent-skills" }]
}
