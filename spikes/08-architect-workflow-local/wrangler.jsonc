{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spike-08-architect-workflow-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-07",
  "d1_databases": [
    {
      "binding": "ARCHITECT_DB",
      "database_name": "spike-08-architect-local",
      "database_id": "local-spike-08",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PROPOSALS", "bucket_name": "spike-08-proposals" }],
  "durable_objects": {
    "bindings": [{ "name": "DIAGRAM_ROOM", "class_name": "DiagramRoom" }]
  },
  "exports": {
    "DiagramRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    {
      "binding": "ARCHITECTURE_WORKFLOW",
      "name": "spike-08-architecture-workflow",
      "class_name": "ArchitectureWorkflow"
    }
  ]
}
