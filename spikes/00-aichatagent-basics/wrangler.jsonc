{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spike-00-aichatagent-basics",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // No inbound HTTPS endpoint is ever deployed for this spike (see README.md) — this config is
  // used exclusively with `wrangler dev`, which serves the Worker's own HTTP/WebSocket interface
  // on localhost even while the `ai` binding below proxies to the real account. `workers_dev` and
  // `preview_urls` are left at their schema defaults (both `false`) since nothing here is ever
  // published to *.workers.dev or previewed.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  // Workers AI has no local simulator (docs/05-AI-CHAT.md, "Workers AI Has No Local Simulation";
  // docs/DECISIONS.md #9): this binding always reaches the real account. `remote` must be `true`
  // explicitly — Cloudflare errors on `false` and warns (while still connecting remotely) if
  // omitted.
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
