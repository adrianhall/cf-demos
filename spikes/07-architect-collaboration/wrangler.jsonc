{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spike-07-architect-collaboration",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-29",
  "durable_objects": {
    "bindings": [{ "name": "DIAGRAM_ROOM", "class_name": "DiagramRoom" }]
  },
  "exports": {
    "DiagramRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
