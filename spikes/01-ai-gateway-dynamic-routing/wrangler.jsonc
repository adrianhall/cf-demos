{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spike-01-ai-gateway-dynamic-routing",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-29",
  // A real deployment this time, not `wrangler dev` (see README.md: the operator's sandbox
  // cannot reach Cloudflare's remote-binding proxy, so `env.AI.aiGatewayLogId`/`getLog()` —
  // Workers Runtime features with no plain-HTTP equivalent — can only be observed against a
  // deployed Worker's own public hostname, fronted by the Access bypass application `infra/`
  // provisions per Section 8's second spike category).
  "workers_dev": true,
  // Workers AI has no local simulator (docs/05-AI-CHAT.md, "Workers AI Has No Local Simulation";
  // docs/DECISIONS.md #9): this binding always reaches the real account. `remote` must be `true`
  // explicitly — Cloudflare errors on `false` and warns (while still connecting remotely) if
  // omitted. The AI Gateway itself is chosen per-call via `env.AI.run()`'s own `gateway: { id }`
  // option (Section 6.3), not by this binding declaration.
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
