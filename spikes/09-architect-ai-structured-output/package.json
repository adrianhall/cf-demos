{
  "name": "@cf-spikes/09-architect-ai-structured-output",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "generate:types": "wrangler types",
    "check": "npm run generate:types && tsc --noEmit && terraform -chdir=infra fmt -check && terraform -chdir=infra validate",
    "provision": "terraform -chdir=infra init && terraform -chdir=infra apply -auto-approve",
    "deploy": "npm run generate:types && wrangler deploy",
    "probe": "node scripts/probe.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "run": "node scripts/run.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.115.0"
  }
}
