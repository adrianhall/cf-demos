# Required permissions:
#   Entire Account:
#     Developer Platform:
#       Workers Scripts : Edit
#       D1 : Edit
#       Workers AI : Read
#       AI Gateway : Edit
#     Cloudflare One / Zero Trust:
#       Access : Edit
#       Access: Identity Providers : Read
#   <your-domain>:
#     DNS & Zones:
#       DNS : Write
#
# Add only the permissions required by the products demonstrated.
# Logs and analytics read access is operational, not required for deployment.
#
# This file documents only Cloudflare API token permissions. The GitHub/GitLab personal access
# tokens and webhook secrets this demo also needs are documented separately in
# .dev.vars.example (local development) and README.md (the one-time `wrangler secret put`
# commands for a real deployment) -- see docs/07-PR-REVIEW-AGENT.md's "Explicit Exceptions".
CLOUDFLARE_API_TOKEN="<from-dashboard>"
CLOUDFLARE_ACCOUNT_ID="<from-dashboard>"

# The domain your applications are going to be hosted under
CLOUDFLARE_ZONE_ID="<from-dashboard>"
DEMO_DOMAIN="cfapps.uk"

# Your Cloudflare Access team domain, without the https:// prefix. Required from Phase 2 onward
# when the hostname-wide Access application is provisioned.
CLOUDFLARE_TEAM_DOMAIN="<from-dashboard>"

# The name of the worker for the demo
DEMO_NAME="review-agent"
