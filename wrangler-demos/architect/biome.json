{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!package.json",
      "!dist",
      "!coverage",
      "!.wrangler",
      "!worker-configuration.d.ts",
      "!test-results",
      "!public",
      "!src/client/lib/scaffold-templates",
      "!src/client/icons"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
