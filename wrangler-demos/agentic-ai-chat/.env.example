# Required permissions:
#   Entire Account:
#     Developer Platform:
#       Workers Scripts : Edit
#       D1 : Edit
#       Workers AI : Edit
#       AI Gateway : Edit
#       Workers R2 Storage : Edit
#     Cloudflare One / Zero Trust:
#       Access : Edit
#       Access: Identity Providers : Read
#   <your-domain>:
#     DNS & Zones:
#       DNS : Write     
#
# Add only the permissions required by the products demonstrated.
# Logs and analytics read access is operational, not required for deployment.
#
# "Workers AI : Edit" is required only for local development: the `AI` binding has no local
# simulator (see docs/05-AI-CHAT.md), so `vite dev`/`vitest` open a real, credentialed session
# against the account. Deploying the Worker itself needs only `Workers Scripts : Edit`.
# "AI Gateway : Edit" is required for Terraform to provision the gateway and its two dynamic
# routes (`cloudflare_ai_gateway`/`cloudflare_ai_gateway_dynamic_routing`), and also covers the
# one runtime REST call this demo's cost ledger makes directly (not through a binding) to read
# back a turn's logged cost -- `ChatAgent.reconcileUsage()`, docs/06-AGENTIC-CHAT.md Section 6.6.
# This same token is pushed as the deployed Worker's own CLOUDFLARE_API_TOKEN secret by
# `npm run deploy:worker:secrets`; it is never committed to wrangler.jsonc.
# "Workers R2 Storage : Edit" is required for Terraform to provision the bucket
# (`cloudflare_r2_bucket`, Phase 9) `ChatAgent`'s `writeMarkdown` tool stores files in, and for
# the `empty-r2-bucket` preteardown CLI to empty it before `terraform destroy` runs.
CLOUDFLARE_API_TOKEN="<from-dashboard>"
CLOUDFLARE_ACCOUNT_ID="<from-dashboard>"

# The domain your applications are going to be hosted under
CLOUDFLARE_ZONE_ID="<from-dashboard>"
DEMO_DOMAIN="<your-domain>"

# Your Cloudflare Access team domain, without the https:// prefix.
CLOUDFLARE_TEAM_DOMAIN="<from-dashboard>"

# The name of the worker for the demo
DEMO_NAME="agentic-chat"

# The user promoted to this demo's administrator role (a D1 flag, not a Cloudflare Access
# concept -- see docs/06-AGENTIC-CHAT.md Section 6.5). Idempotently re-applied on every sign-in
# so it survives a redeploy or partial teardown.
ADMIN_EMAIL="admin@example.com"
