{
  "name": "@cf-demos/swapi-graphql",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "run-s generate:wrangler:local generate:types",
    "build": "tsc --noEmit",
    "check": "run-s check:* check:infra:fmt",
    "check:format": "biome format .",
    "check:infra": "terraform -chdir=infra validate",
    "check:infra:fmt": "terraform -chdir=infra fmt -check",
    "check:lint": "biome lint .",
    "precheck:types": "run-s generate:wrangler:local generate:types",
    "check:types": "tsc --noEmit",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "CI=1 wrangler d1 migrations apply DB --remote",
    "deploy": "run-s infra:init infra:apply deploy:worker",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc",
    "format": "run-s format:*",
    "format:biome": "biome format --write .",
    "format:infra": "terraform -chdir=infra fmt",
    "generate:types": "generate-wrangler-types -- --include-runtime=false --strict-vars=false",
    "generate:types:force": "generate-wrangler-types -f -- --include-runtime=false --strict-vars=false",
    "generate:wrangler": "generate-wrangler -cf --terraform infra",
    "generate:wrangler:local": "generate-wrangler -c -l infra/local-outputs.json",
    "infra:apply": "terraform -chdir=infra apply -auto-approve",
    "infra:destroy": "terraform -chdir=infra destroy -auto-approve",
    "infra:init": "terraform -chdir=infra init",
    "predb:migrate:local": "run-s generate:wrangler:local generate:types",
    "predeploy:worker": "run-s generate:wrangler generate:types:force db:migrate:remote build",
    "prestart": "run-s generate:wrangler:local generate:types",
    "start": "wrangler dev",
    "pretest": "run-s generate:wrangler:local generate:types",
    "test": "vitest run --passWithNoTests",
    "pretest:coverage": "run-s generate:wrangler:local generate:types",
    "test:coverage": "vitest run --coverage --coverage.provider=istanbul --passWithNoTests",
    "pretest:integration": "run-s generate:wrangler:local generate:types",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "teardown": "run-s teardown:worker infra:destroy teardown:generated",
    "teardown:generated": "shx rm -f wrangler.jsonc worker-configuration.d.ts",
    "teardown:worker": "wrangler delete --force --config wrangler.jsonc"
  },
  "devDependencies": {
    "@adrianhall/cloudflare-toolkit": "2.3.0",
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "npm-run-all2": "9.0.3",
    "shx": "0.3.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true,
    "fsevents": false
  },
  "dependencies": {
    "@pothos/core": "4.13.1",
    "@pothos/plugin-complexity": "4.2.1",
    "graphql": "16.14.2",
    "graphql-yoga": "5.21.2",
    "hono": "4.13.0"
  }
}
