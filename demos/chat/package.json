{
  "name": "@cf-demos/chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "run-s generate:wrangler:local generate:types",
    "build": "vite build",
    "check": "run-s check:* check:infra:fmt",
    "check:format": "biome format .",
    "check:infra": "terraform -chdir=infra validate",
    "check:infra:fmt": "terraform -chdir=infra fmt -check",
    "check:lint": "biome lint .",
    "precheck:types": "run-s generate:wrangler:local generate:types",
    "check:types": "tsc --noEmit",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "CI=1 wrangler d1 migrations apply DB --remote",
    "deploy": "run-s deploy:infra deploy:worker",
    "deploy:infra": "run-s deploy:infra:init deploy:infra:apply",
    "deploy:infra:init": "terraform -chdir=infra init",
    "deploy:infra:apply": "terraform -chdir=infra apply -auto-approve",
    "predeploy:worker": "run-s generate:wrangler generate:types",
    "deploy:worker": "run-s db:migrate:remote deploy:worker:publish",
    "deploy:worker:publish": "vite build && wrangler deploy",
    "format": "run-s format:*",
    "format:biome": "biome format --write .",
    "format:infra": "terraform -chdir=infra fmt",
    "generate:types": "generate-wrangler-types",
    "generate:wrangler": "generate-wrangler -cf --terraform infra",
    "generate:wrangler:local": "generate-wrangler -c -l infra/local-outputs.json",
    "prestart": "run-s generate:wrangler:local generate:types db:migrate:local build",
    "start": "vite dev",
    "teardown": "terraform -chdir=infra destroy -auto-approve",
    "postteardown": "shx rm -f wrangler.jsonc worker-configuration.d.ts",
    "pretest": "run-s generate:wrangler:local generate:types",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:client": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project client",
    "pretest:coverage": "run-s generate:wrangler:local generate:types",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "pretest:integration": "run-s generate:wrangler:local generate:types",
    "test:integration": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project integration",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project worker --project client",
    "test:worker": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project worker"
  },
  "dependencies": {
    "@adrianhall/cloudflare-toolkit": "2.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "hono": "4.12.32",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-feather": "^2.0.0",
    "vue-router": "5.2.0",
    "vuetify": "4.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@pinia/testing": "2.0.1",
    "@types/node": "26.1.2",
    "@vue/test-utils": "2.4.11",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true,
    "fsevents": false,
    "core-js@3.49.0": true
  }
}
