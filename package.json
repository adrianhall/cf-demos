{
  "name": "demos",
  "version": "1.0.0",
  "description": "A set of demos for the Cloudflare Workers platform.",
  "keywords": [
    "cloudflare",
    "demo",
    "example",
    "sample"
  ],
  "license": "MIT",
  "author": "Adrian Hall <ahall@cloudflare.com>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "pnpm --recursive --workspace-concurrency=1 check",
    "create-env": "node scripts/create-env.ts",
    "d1-migrate": "node scripts/d1-migrate.ts",
    "test": "pnpm --recursive --workspace-concurrency=1 test"
  },
  "dependencies": {
    "oxfmt": "0.72.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.7.3",
    "@types/node": "26.6.4",
    "cf": "1.0.0-beta.14",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
