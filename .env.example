############################################################
#
# Central .env file for all demonstrations
#
# This file is used to deploy all demo applications in this
# repository.  It primarily relies on creating appropriate
# keys (API tokens) for the deployment
#
############################################################

# A Cloudflare API token with permissions for:
# Entire Account:
#   Developer Platform:
#       AI Gateway: Edit
#       D1: Edit
#       Workers AI: Edit
#       Workers KV Storage: Edit
#       Workers Scripts: Edit
#       Workers R2 Storage: Edit
#   Cloudflare One / Zero Trust:
#       Access: Edit
#       Access: Identity Providers: Read
# <your-domain>:
#   DNS & Zones:
#       DNS: Edit
#
CLOUDFLARE_API_TOKEN="<from-dashboard>"

# Account ID for your Cloudflare account.  
# Use `cf auth whoami` to get your account ID
CLOUDFLARE_ACCOUNT_ID="<your-account-id>"

# Domain name to be used for all demos
CLOUDFLARE_DOMAIN="<your-domain>"

# Zone ID for the domain
# Use `cf zones list` to get your zone ID
CLOUDFLARE_ZONE_ID="<your-zone-id>"

# Cloudflare Zero Trust team domain
# Use `cf zero-trust organizations list` to get your team domain
CLOUDFLARE_TEAM_DOMAIN="<your-team-domain>"

# Administrator email address.  This is the email address that should always
# be considered an admin where admin functions are available
ADMIN_EMAIL="<your-email-address>"
